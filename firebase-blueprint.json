    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Koleksi pengumuman sekolah"
    },
    "/reflections/{reflectionId}": {
      "schema": "Reflection",
      "description": "Koleksi catatan refleksi siswa"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Konfigurasi aplikasi"
    },
    "/competency_submissions/{submissionId}": {
      "schema": "CompetencySubmission",
      "description": "Koleksi konfirmasi pengerjaan uji kompetensi siswa"
    },
    "/assignments/{assignmentId}": {
      "schema": "Assignment",
      "description": "Koleksi tugas PJOK siswa"
    },
